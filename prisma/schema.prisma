generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon POOLED URL (runtime)
  directUrl = env("DATABASE_URL_UNPOOLED") // Neon DIRECT URL (migrations)
}

enum ProductStatus {
  ACTIVE
  DRAFT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryZone {
  INSIDE_DHAKA
  DHAKA_SUBURBAN
  OUTSIDE_DHAKA
}

enum CouponType {
  FIXED
  PERCENTAGE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sortOrder])
}

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  shortDescription String?
  description      String           @db.Text
  specs            Json             @default("[]")
  tags             String[]
  status           ProductStatus    @default(DRAFT)
  isFeatured       Boolean          @default(false)
  isBestseller     Boolean          @default(false)
  colorLabel       String?
  sizeLabel        String?
  sizeGuide        String?
  minPrice         Int              @default(0)
  maxPrice         Int              @default(0)
  minCompareAt     Int?
  onSale           Boolean          @default(false)
  totalStock       Int              @default(0)
  soldCount        Int              @default(0)
  ratingAvg        Float            @default(0)
  ratingCount      Int              @default(0)
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  variants         ProductVariant[]
  reviews          Review[]
  orderItems       OrderItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, categoryId])
  @@index([status, createdAt])
  @@index([status, minPrice])
  @@index([status, soldCount])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String      @unique
  color          String?
  size           String?
  price          Int
  compareAtPrice Int?
  stock          Int         @default(0)
  imageUrl       String?
  sortOrder      Int         @default(0)
  orderItems     OrderItem[]

  @@index([productId])
  @@index([color])
  @@index([size])
}

model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  rating    Int
  comment   String       @db.Text
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@index([productId, status])
  @@index([status, createdAt])
}

model Customer {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String
  email     String?
  district  String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            String       @id @default(cuid())
  orderNumber   String       @unique
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName  String
  phone         String
  email         String?
  address       String       @db.Text
  district      String
  thana         String
  zone          DeliveryZone
  notes         String?      @db.Text
  status        OrderStatus  @default(PENDING)
  paymentMethod String       @default("COD")
  subtotal      Int
  discount      Int          @default(0)
  shippingFee   Int
  total         Int
  couponCode    String?
  couponId      String?
  coupon        Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  stockRestored Boolean      @default(false)
  items         OrderItem[]
  events        OrderEvent[]
  internalNotes OrderNote[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([phone])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName  String
  variantLabel String?
  sku          String
  image        String?
  unitPrice    Int
  quantity     Int
  lineTotal    Int

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  author    String
  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderSequence {
  day  String @id
  last Int    @default(0)
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Int
  minOrderValue Int        @default(0)
  maxDiscount   Int?
  usageLimit    Int?
  usedCount     Int        @default(0)
  expiresAt     DateTime?
  isActive      Boolean    @default(true)
  orders        Order[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Banner {
  id         String   @id @default(cuid())
  image      String
  heading    String
  subheading String?
  ctaText    String?
  ctaLink    String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  coverImage  String
  body        String    @db.Text
  tags        String[]
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model StoreSettings {
  id                   String   @id @default("store")
  shippingInsideDhaka  Int      @default(70)
  shippingSubDhaka     Int      @default(110)
  shippingOutsideDhaka Int      @default(150)
  whatsappNumber       String   @default("8801700000000")
  contactPhone         String?
  contactEmail         String?
  address              String?
  facebookUrl          String?
  instagramUrl         String?
  tiktokUrl            String?
  youtubeUrl           String?
  updatedAt            DateTime @updatedAt
}
