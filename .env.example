# Neon POOLED connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon DIRECT (unpooled) connection string. Used by `prisma migrate` only.
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Long random string (32+ chars) used to sign the admin JWT. Generate: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
# Admin user created/updated by `npm run db:seed`
ADMIN_EMAIL="admin@zodsbd.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Zod's Admin"
# Vercel Blob read/write token (auto-added on Vercel when you connect a Blob store)
BLOB_READ_WRITE_TOKEN=""
# Public site URL, used for SEO, sitemap and OG images (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
